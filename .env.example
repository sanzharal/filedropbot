# Telegram bot token from @BotFather
BOT_TOKEN=

# Your numeric Telegram user ID — the ONLY account allowed to use the bot.
# Get it by messaging @userinfobot on Telegram.
ALLOWED_USER_ID=

# Days to keep dropped files before auto-delete (received drops + sent archive)
RETENTION_DAYS=7

# Seconds a file must sit untouched in the outbox before it's sent back (optional)
# OUTBOX_SETTLE_SEC=2
